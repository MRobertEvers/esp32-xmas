	(text "12 V INPUT  -  5.5 x 2.1 mm barrel, centre positive"
		(exclude_from_sim no)
		(at 17.78 40.64 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "65ed7d83-434c-5620-9d94-a8ffce7f4670")
	)
	(text "F1: 5 A PTC.  D1: 15 V TVS (clamps hot-plug transients; forward-biased on reversed supply so F1 trips).\nQ1: P-FET in the high side, body diode toward the load - drops ~30 mV instead of a Schottky's 0.5 V.\nRated for 12 V in only: Q1 Vgs and D1 standoff both assume a 12 V adapter."
		(exclude_from_sim no)
		(at 17.78 48.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b306838c-ed40-54a1-9dfc-dbcc19bbb7fc")
	)
