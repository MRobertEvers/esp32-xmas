# ESP-IDF build output
build/

# Generated Kconfig (keep sdkconfig.defaults)
sdkconfig
sdkconfig.old

# Component Manager downloads (restored on build from idf_component.yml)
managed_components/

# dependencies.lock is tracked for reproducible component versions

# Local overrides (Wi-Fi credentials, machine-specific options)
sdkconfig.local

# clangd / IDE helpers (often symlinked from build/)
compile_commands.json
.cache/

# Editor
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Python
__pycache__/
*.py[cod]
